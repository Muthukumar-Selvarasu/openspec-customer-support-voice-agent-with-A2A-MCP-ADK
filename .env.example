# Copy to .env and fill the two API keys for live local turns.
# Leave GOOGLE_GENAI_USE_VERTEXAI unset.

GOOGLE_API_KEY=
MEM0_API_KEY=

# MASK=true runs the A2A Data Masker on every reply.
# MASK=false skips it. AGENT_RESPONSE_STREAM speaks each sentence as it is
# generated and applies only when MASK=false.
MASK=true
AGENT_RESPONSE_STREAM=false

# TELEMETRY=true traces turns in Arize Phoenix. TELEMETRY=false stays off.
TELEMETRY=true

# Local Podman Postgres (compose.yaml service `postgres`).
DATABASE_URL=postgresql://toolbox_user:mysecretpassword@127.0.0.1:5432/toolbox_db

# Host-published service URLs. WEB_PORT is an alias of PORT.
TOOLBOX_URL=http://127.0.0.1:5000
A2A_JUDGE_HOST=localhost
A2A_JUDGE_PORT=10002
A2A_MASK_HOST=localhost
A2A_MASK_PORT=10003
PHOENIX_URL=http://localhost:6006
PHOENIX_PUBLIC_URL=http://localhost:6006
HOST=127.0.0.1
PORT=8000
WEB_PORT=8000
